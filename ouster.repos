# Upstream Ouster ROS 2 driver — fetched at image-build time by docker/Dockerfile.runtime
# (tools/fetch_upstream.py, using vcstool). Nothing upstream is committed to this repo;
# it lives only in the build and in a gitignored src/ for local dev. The SDK override is
# pinned independently in ouster-sdk.repos and applied by the same fetch helper.
#
# `version` MUST be an exact tag or commit SHA (never a branch) for reproducible builds. A bump
# here must also bump rigging.yaml `msgs.source.ref` (the fleet-ros-msgs overlay pin for
# ouster_sensor_msgs — same repo), or bag-recorded schemas silently skew. Upstream's
# ros2-branch releases are tagged plain `MAJOR.MINOR.PATCH` (newer scheme) and/or per-distro
# (`kilted-0.15.1`, `rolling-0.15.1`, … all the same commit). Bump this to a newer release tag to
# update; watch for a future `lyrical-*` tag. See README "Updating upstream".
#
# A LAN mirror must cover both manifests and any upstream submodules; retain all pinned refs.
repositories:
  ouster-ros:
    type: git
    url: https://github.com/ouster-lidar/ouster-ros.git
    version: 0.15.1          # latest stable release tag (commit 73cf036) on the ros2 lineage
