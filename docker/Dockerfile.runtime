# syntax=docker/dockerfile:1
# Minimal production image for the upstream ouster-ros driver, VENDORED AT BUILD TIME. Self-contained
# two-stage build: tools/fetch_upstream.py fetches the pinned ROS driver and SDK override
# from their .repos manifests and compiles them (Release); the runtime stage ships the install/ overlay on
# BASE_IMAGE (default ros-core), with exec-only deps resolved by rosdep (no hand-listed,
# version-fragile lib names).
#
#   docker build -f docker/Dockerfile.runtime -t ouster_driver:<tag> .
# Cross-arch (Jetson/arm64): docker buildx build --platform linux/arm64 ... --load  — build on an
# arm64 host; the SDK/PCL compile is painfully slow under qemu emulation.
#
# Layer caching: source manifests and the fetch helper are copied before the source fetch,
# so changing a pin invalidates the fetched sources and build.
ARG ROS_DISTRO=lyrical
# Shared build/runtime parent. Under rig, tools/build_image.sh forwards RIG_BASE_IMAGE so both stages
# use the deployment's one shared base (fleet-ros = ros-base + rmw-zenoh +
# rosbag2/mcap): shared ros-* packages then come from literally the same layers as the
# router/bag-logger, vehicle-side pull cost drops via layer sharing, and the explicit rmw installs
# below become no-ops held at the parent's versions by the apt policy. Standalone builds keep the
# slim ros-core parent. The ldd gate at the end of the runtime stage is the safety net for the
# re-parent: every shipped ELF must still resolve, at image-build time.
ARG BASE_IMAGE=ros:${ROS_DISTRO}-ros-core

# Resolve the parent once, then use it for BOTH stages. A separately cached ros-base builder
# can generate interfaces for a different ROS ABI than the fleet runtime.
FROM ${BASE_IMAGE} AS base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# --no-upgrade alone does not prevent the dependency solver upgrading installed packages.
# Hold the parent's ROS packages in both stages; incompatible new dependencies must fail
# the build so the fleet base can be refreshed deliberately.
RUN dpkg-query -W -f='${Package} ${db:Status-Status}\n' 'ros-*' \
      | awk '$2 == "installed" {print $1}' | xargs -r apt-mark hold

# ---- build stage ------------------------------------------------------------
FROM base AS build
ARG ROS_DISTRO
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Stage-wide apt policy (see the runtime stage's copy for the full rationale): recommends off +
# no upgrades past the parent image. The builder doesn't ship, but the .so's should compile
# against the same ros-* versions the runtime stage holds, so the same parent-sync rule applies.
RUN printf 'APT::Install-Recommends "0";\nAPT::Install-Suggests "0";\nAPT::Get::Upgrade "false";\n' \
      > /etc/apt/apt.conf.d/99-rig-apt-policy
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git ca-certificates \
      python3-colcon-common-extensions python3-rosdep python3-vcstool \
  && rm -rf /var/lib/apt/lists/* \
  && (rosdep init 2>/dev/null || true)

WORKDIR /workspace
# Fetch both exact source versions. The helper replaces the SDK only inside a fresh checkout,
# fails on fetch/submodule errors, and records the actual commits used by this build.
COPY ouster.repos ouster-sdk.repos /workspace/
COPY tools/fetch_upstream.py /workspace/tools/fetch_upstream.py
RUN python3 /workspace/tools/fetch_upstream.py /workspace/src

# fleet-msgs provenance (rig image audit ≥ v0.2.30): record what the checkout above ACTUALLY used
# for the ouster_sensor_msgs interfaces — declared ref + resolved commit SHA — at the one
# well-known path audit probes. url/ref are parsed from ouster.repos, the very file `vcs import`
# consumed, never re-typed from rigging.yaml's msgs declaration (a re-echo would make the audit
# compare the declaration against itself, hiding real drift). The runtime stage must COPY the file
# out — provenance dying with this throwaway stage is the doctrine's default failure mode.
# Helper is vendored from rig-infra msgs/provenance-record.sh.
COPY docker/provenance-record.sh /usr/local/bin/provenance-record.sh
RUN url="$(awk '$1 == "url:" {print $2}' /workspace/ouster.repos)" \
 && ref="$(awk '$1 == "version:" {print $2}' /workspace/ouster.repos)" \
 && sh /usr/local/bin/provenance-record.sh /opt/fleet-msgs/provenance.yaml \
      "$url" "$ref" /workspace/src/ouster-ros ouster_sensor_msgs

# Resolve every declared dep from the vendored package.xml files (ROS pkgs + system libs: pcl,
# opencv via cv_bridge, curl, spdlog, jsoncpp, eigen, ...). rosdep, not a hand-maintained apt list.
RUN apt-get update \
 && rosdep update --rosdistro "${ROS_DISTRO}" \
 && rosdep install --from-paths /workspace/src --ignore-src -y --rosdistro "${ROS_DISTRO}" \
 && rm -rf /var/lib/apt/lists/*

# Lyrical removed ament_target_dependencies (upstream ouster-ros still calls it); inject a
# backward-compat shim WITHOUT touching upstream sources — scoped to the ouster_ros project via
# CMAKE_PROJECT_<name>_INCLUDE (see the .cmake file's header). Remove once upstream supports Lyrical.
COPY docker/ament_target_dependencies_compat.cmake /workspace/ament_compat.cmake

# Build Release. Optional SDK features (pcap/osf/viz/mapping) stay OFF, so their extra runtime libs
# (libtins/...) aren't linked or shipped. NOTE: libzip is NOT one of them — ouster_client links it
# unconditionally at this pin (BUILD_OSF=OFF does not gate it); see docker/runtime_extra_deps/.
# -Wno-deprecated-declarations matches upstream's own Dockerfile.
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
 && colcon build --base-paths /workspace/src --merge-install \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS="-Wno-deprecated-declarations" \
                   -DCMAKE_PROJECT_ouster_ros_INCLUDE=/workspace/ament_compat.cmake \
                   -DBUILD_TESTING=OFF \
                   -DBUILD_PCAP=OFF -DBUILD_OSF=OFF -DBUILD_VIZ=OFF -DBUILD_MAPPING=OFF
# Record the actual compiler environment, including deps absent from the parent. The final
# stage compares all overlapping ROS packages, catching stale independently cached apt layers.
RUN dpkg-query -W -f='${Package}\t${Version}\t${db:Status-Status}\n' 'ros-*' \
      | awk '$3 == "installed" {print $1 "\t" $2}' > /workspace/build-ros-packages.tsv

# ---- runtime stage ----------------------------------------------------------
FROM base AS runtime
ARG ROS_DISTRO
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Exec-only runtime deps, resolved by rosdep from the same package.xml manifests (so the list tracks
# upstream automatically). Copy just the manifests, resolve, drop them.
# Stage-wide apt policy, written as apt.conf because rosdep's internal apt calls can't take
# per-call flags:
#   - recommends/suggests off (rosdep doesn't pass --no-install-recommends itself);
#   - no upgrades past the parent image. The locally-pulled parent is the ros-* version authority,
#     advanced deliberately via `rig build --no-cache` (=> docker build --pull) — the fleet
#     convergence rule behind `rig image audit`'s cross-image agreement check: `apt-get install`
#     of a package the parent already carries silently upgrades it to build-day candidates, so
#     every uncached rebuild would race ahead of the parent and disagree with fleet images built
#     on other dates. New packages still install normally; parent-carried ones stay at parent
#     versions. The base stage additionally holds ROS packages, preventing implicit solver
#     upgrades; refresh the fleet base if a new dependency requires newer ROS packages.
RUN printf 'APT::Install-Recommends "0";\nAPT::Install-Suggests "0";\nAPT::Get::Upgrade "false";\n' \
      > /etc/apt/apt.conf.d/99-rig-apt-policy
# Both RMWs are baked in; the deploy compose selects one per instance via RMW_IMPLEMENTATION
# (default rmw_fastrtps_cpp). rmw_zenoh_cpp additionally needs a Zenoh router reachable on
# localhost — see docker/README.md "RMW selection / Zenoh". Under the fleet-ros parent both are
# already present and the apt policy holds them at the parent's versions.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-rosdep python3-yaml ros-${ROS_DISTRO}-rmw-fastrtps-cpp ros-${ROS_DISTRO}-rmw-zenoh-cpp \
  && rm -rf /var/lib/apt/lists/* \
  && (rosdep init 2>/dev/null || true)
COPY --from=build /workspace/src/ouster-ros/ouster-ros/package.xml /tmp/deps/ouster_ros/package.xml
COPY --from=build /workspace/src/ouster-ros/ouster-sensor-msgs/package.xml /tmp/deps/ouster_sensor_msgs/package.xml
# Wrapper deps and upstream manifest gaps (see the file's header):
# rides the same rosdep pass as the upstream manifests, so nothing is hand-pinned to a soname.
COPY docker/runtime_extra_deps/package.xml /tmp/deps/ouster_wrapper_runtime_deps/package.xml
# pcl_conversions and cv_bridge are skipped: the driver uses both HEADER-ONLY — the shipped .so's
# link no libpcl* and no libcv_bridge (the ldd gate below is the proof) — yet their debs
# hard-depend on libpcl-dev/libopencv-dev, dragging ~5 GB of toolchain (gcc/gfortran), VTK, Java
# and Boost -dev into an exec-only image. The three OpenCV runtime libs the driver DOES link
# (core/imgcodecs/imgproc) are derived from cv_bridge's own deb metadata below, so the sonames
# stay distro-maintained, never hand-pinned here. If a future pin starts linking either library
# for real, the ldd gate fails the build and this carve-out must be revisited.
RUN apt-get update \
 && rosdep update --rosdistro "${ROS_DISTRO}" \
 && rosdep install --from-paths /tmp/deps --ignore-src -y --rosdistro "${ROS_DISTRO}" \
      --dependency-types=exec --skip-keys "pcl_conversions cv_bridge" \
 && apt-get install -y --no-install-recommends \
      $(apt-cache depends --no-recommends "ros-${ROS_DISTRO}-cv-bridge" \
        | awk '/Depends:/{print $2}' | grep '^libopencv-' | grep -v -- '-dev$') \
 && rm -rf /tmp/deps /var/lib/apt/lists/* /root/.ros

COPY --from=build /workspace/install /opt/ouster_driver
COPY --from=build /workspace/build-ros-packages.tsv /opt/ouster_driver/share/build-ros-packages.tsv
COPY --from=build /workspace/src/ouster-ros/upstream-sources.json /opt/ouster_driver/share/upstream-sources.json
# fleet-msgs provenance must outlive the throwaway build stage (rig-infra msgs doctrine's default
# failure mode) — `rig image audit` reads it from THIS image at /opt/fleet-msgs/provenance.yaml.
COPY --from=build /opt/fleet-msgs/provenance.yaml /opt/fleet-msgs/provenance.yaml
# Gate: every shipped ELF must resolve ALL its shared libs against exactly what this stage
# installed (same env the entrypoint sets up). Catches upstream manifest gaps — like libzip at
# 0.15.1 — at image-build time (CI) instead of as a dlopen failure on the vehicle.
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
 && source /opt/ouster_driver/setup.bash \
 && test -n "$(find /opt/ouster_driver -name '*.so' -print -quit)" \
 && { find /opt/ouster_driver -type f \( -name '*.so*' -o -perm -111 \) \
        -exec sh -c 'ldd "$1" 2>/dev/null | grep -H --label="$1" "not found"' _ {} \; \
        > /tmp/ldd_gaps || true; } \
 && if [ -s /tmp/ldd_gaps ]; then \
      echo "ERROR: shipped binaries have unresolved shared libraries:"; cat /tmp/ldd_gaps; exit 1; \
    fi \
 && rm -f /tmp/ldd_gaps
# ldd without -r only checks library names. Force eager loading of the ROS libraries too:
# generated type support can otherwise ship with undefined symbols and crash on first use.
COPY docker/check_runtime.py /usr/local/bin/ouster-check-runtime.py
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
 && source /opt/ouster_driver/setup.bash \
 && python3 /usr/local/bin/ouster-check-runtime.py /opt/ouster_driver \
      --build-packages /opt/ouster_driver/share/build-ros-packages.tsv
# Context is the repo root (the build stage fetches sources itself), so entrypoints live under docker/.
# statectl.sh implements the operational-state verbs (standby/activate/state) the launcher execs.
COPY docker/entrypoints/ros-entrypoint.sh /usr/local/bin/ros-entrypoint.sh
COPY docker/entrypoints/healthcheck.sh /usr/local/bin/healthcheck.sh
COPY docker/entrypoints/statectl.sh /usr/local/bin/statectl.sh
COPY docker/entrypoints/operational_state.py docker/entrypoints/sensor_http.py docker/entrypoints/temperature.py docker/entrypoints/health.py docker/entrypoints/health_ros.py docker/entrypoints/lifecycle_ros.py /usr/local/bin/
RUN chmod +x /usr/local/bin/ros-entrypoint.sh /usr/local/bin/healthcheck.sh /usr/local/bin/statectl.sh

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
ENV OUSTER_DRIVER_WORKSPACE=/opt/ouster_driver
# Allow the bounded wake-up + driver configure sequence during startup. Each
# readiness probe checks physical sensor state and (when running) ROS lifecycle.
HEALTHCHECK --interval=30s --timeout=20s --start-period=240s --retries=3 CMD ["/usr/local/bin/healthcheck.sh"]
ENTRYPOINT ["/usr/local/bin/ros-entrypoint.sh"]
# Bare runs must mount a params file at /etc/ouster_driver/params.yaml (or set
# OUSTER_PARAMS_FILE). The supervisor starts the upstream headless launch after wake-up.
CMD ["python3", "/usr/local/bin/operational_state.py", "serve"]
